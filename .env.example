# Copy this file to .env and fill in real values for your environment.
# .env is gitignored and must never be committed.

# --- JWT ---
# HS256 needs a secret of at least 32 bytes (256 bits).
# Generate one locally, e.g.: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret-min-32-bytes
JWT_EXPIRATION_MS=3600000

# --- Database ---
# Match these to whatever Postgres instance you're pointing at
# (the docker-compose.yml defaults are orderuser / orderpass / orderdb).
DB_URL=jdbc:postgresql://localhost:5432/orderdb
DB_USERNAME=orderuser
DB_PASSWORD=orderpass
